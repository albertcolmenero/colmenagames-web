# Blog webhook (POST /api/blog-publish). The platform pushes articles here.
# Set the same names in the Vercel project. For local POSTs, copy this file
# to .env.local. Values stay empty in git.
#
# BLOG_WEBHOOK_TOKEN: shared secret. The platform sends it as
#   Authorization: Bearer <token>.
# BLOG_GITHUB_TOKEN: fine-grained GitHub PAT with Contents read and write on
#   THIS repo only. Create it from the GitHub account connected to Vercel so
#   the commit triggers a production deploy.
# BLOG_GITHUB_REPO / BLOG_GITHUB_BRANCH: optional overrides
#   (defaults: albertcolmenero/colmenagames-web, main).
BLOG_WEBHOOK_TOKEN=
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_REPO=
BLOG_GITHUB_BRANCH=
